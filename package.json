{
  "name": "nimeplay",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.4.3",
  "imports": {
    "#lib": "./src/lib/index.ts",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "bun --env-file=.env.local vite dev",
    "build": "vite build",
    "preview": "bun --env-file=.env.local vite preview",
    "lint": "oxlint .",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --incremental",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "bun run src/lib/server/database/seed.ts"
  },
  "trustedDependencies": [
    "esbuild",
    "workerd"
  ],
  "dependencies": {
    "@effect/platform-bun": "^4.0.2",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@neondatabase/serverless": "^1.1.0",
    "aws4fetch": "^1.0.20",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.45.2",
    "effect": "^4.0.2",
    "google-translate-api-x": "10.7.3",
    "hls.js": "^1.7.3",
    "idb": "^8.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "^8.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.2",
    "drizzle-kit": "^0.31.10",
    "oxlint": "1.87.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "wrangler": "^4.131.1"
  }
}
