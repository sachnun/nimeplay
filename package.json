{
  "name": "nimeplay",
  "type": "module",
  "private": true,
  "packageManager": "npm@12.0.2",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "typecheck": "nuxt typecheck",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply nimeplay --remote",
    "db:migrate:local": "wrangler d1 migrations apply nimeplay --local",
    "scrape": "tsx scripts/scrape.ts"
  },
  "dependencies": {
    "@nuxt/fonts": "^0.14.0",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.45.2",
    "hls.js": "^1.6.17",
    "idb": "^8.0.3",
    "nuxt": "^4.5.2",
    "vue": "^3.5.41"
  },
  "overrides": {
    "@bomb.sh/tab": "0.0.22"
  },
  "devDependencies": {
    "@miniflare/d1": "^2.14.4",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^26.1.2",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.9",
    "wrangler": "^4.129.0"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.27.7": true,
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260903.1": true
  }
}
