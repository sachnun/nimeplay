{
  "name": "nimeplay",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "build": "bun --bun nuxt build",
    "dev": "bun --bun nuxt dev",
    "generate": "bun --bun nuxt generate",
    "typecheck": "bun --bun nuxt typecheck",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "bun run server/database/seed.ts"
  },
  "trustedDependencies": [
    "esbuild",
    "workerd"
  ],
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@nuxt/fonts": "^0.14.0",
    "@nuxtjs/device": "^4.0.0",
    "aws4fetch": "^1.0.20",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.45.2",
    "hls.js": "^1.7.3",
    "idb": "^8.0.3",
    "nuxt": "^4.5.2",
    "vue": "3.5.42"
  },
  "overrides": {
    "@bomb.sh/tab": "0.0.22"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.5.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "^6.0.3",
    "vue-tsc": "3.3.11",
    "wrangler": "^4.131.1"
  }
}
