{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nimeplay",
  "compatibility_date": "2026-09-11",
  "placement": {
    "mode": "targeted",
    "region": "gcp:asia-southeast2"
  },
  "triggers": {
    "crons": ["*/30 * * * *", "0 3 * * *"]
  },
  "queues": {
    "producers": [
      {
        "queue": "nimeplay-jobs",
        "binding": "JOBS"
      }
    ],
    "consumers": [
      {
        "queue": "nimeplay-jobs",
        "max_batch_size": 1,
        "max_retries": 3,
        "retry_delay": 30
      }
    ]
  },
  "vars": {
    "MEDIA_BUCKET": "nimeplay",
    "APP_ORIGIN": "https://nimeplay.sachnun.workers.dev"
  }
}
