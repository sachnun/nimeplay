{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nimeplay",
  "compatibility_date": "2026-09-11",
  "placement": {
    "mode": "targeted",
    "region": "gcp:asia-southeast2"
  },
  "triggers": {
    "crons": ["0 */3 * * *", "0 3 * * *", "*/5 * * * *", "*/10 * * * *"]
  },
  "vars": {
    "MEDIA_BUCKET": "nimeplay",
    "APP_ORIGIN": "https://nimeplay.sachnun.workers.dev"
  }
}
